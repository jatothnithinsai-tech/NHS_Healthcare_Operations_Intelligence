table 'Pipeline'
	lineageTag: 22871889-f056-5a39-a909-1b76ee88eeca

	column 'run_id'
		dataType: string
		sourceColumn: run_id
		summarizeBy: none

	column 'started_at'
		dataType: dateTime
		sourceColumn: started_at
		summarizeBy: none
		formatString: dd MMM yyyy HH:mm:ss

	column 'finished_at'
		dataType: dateTime
		sourceColumn: finished_at
		summarizeBy: none
		formatString: dd MMM yyyy HH:mm:ss

	column 'status'
		dataType: string
		sourceColumn: status
		summarizeBy: none

	column 'loaded_files'
		dataType: int64
		sourceColumn: loaded_files
		summarizeBy: sum

	column 'unchanged_files'
		dataType: int64
		sourceColumn: unchanged_files
		summarizeBy: sum

	partition 'Pipeline' = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataRoot & "/Pipeline.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"run_id", type text}, {"started_at", type datetime}, {"finished_at", type datetime}, {"status", type text}, {"loaded_files", Int64.Type}, {"unchanged_files", Int64.Type}}, "en-GB")
			in
				Typed
