table 'Quality'
	lineageTag: 5695957a-9e36-5ca5-a547-07a32600ad13

	column 'check_name'
		dataType: string
		sourceColumn: check_name
		summarizeBy: none

	column 'status'
		dataType: string
		sourceColumn: status
		summarizeBy: none

	column 'months'
		dataType: int64
		sourceColumn: months
		summarizeBy: sum

	column 'row_count'
		dataType: int64
		sourceColumn: row_count
		summarizeBy: sum

	partition 'Quality' = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataRoot & "/Quality.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"check_name", type text}, {"status", type text}, {"months", Int64.Type}, {"row_count", Int64.Type}}, "en-GB")
			in
				Typed
