table 'Date'
	lineageTag: f6b1f86b-f89d-5747-a21b-9ea49275170b
	dataCategory: Time

	column 'month'
		dataType: dateTime
		sourceColumn: month
		summarizeBy: none
		formatString: yyyy-MM-dd

	column 'year'
		dataType: int64
		sourceColumn: year
		summarizeBy: none

	column 'month_number'
		dataType: int64
		sourceColumn: month_number
		summarizeBy: none

	column 'month_name'
		dataType: string
		sourceColumn: month_name
		summarizeBy: none

	column 'financial_year'
		dataType: string
		sourceColumn: financial_year
		summarizeBy: none

	partition 'Date' = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataRoot & "/Date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"month", type datetime}, {"year", Int64.Type}, {"month_number", Int64.Type}, {"month_name", type text}, {"financial_year", type text}}, "en-GB")
			in
				Typed
