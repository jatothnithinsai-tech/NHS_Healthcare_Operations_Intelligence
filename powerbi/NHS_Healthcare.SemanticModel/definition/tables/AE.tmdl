table 'AE'
	lineageTag: eaac638f-e1ac-5f19-8e99-fcdb62656f29

	column 'month'
		dataType: dateTime
		sourceColumn: month
		summarizeBy: none
		formatString: yyyy-MM-dd

	column 'provider_code'
		dataType: string
		sourceColumn: provider_code
