	partition 'AE' = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataRoot & "/AE.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"month", type datetime}, {"provider_code", type text}, {"region_name", type text}, {"attendances", Int64.Type}, {"over_4", Int64.Type}, {"within_4", Int64.Type}, {"type1_attendances", Int64.Type}, {"type1_over_4", Int64.Type}, {"admissions_via_ae", Int64.Type}, {"other_admissions", Int64.Type}, {"emergency_admissions", Int64.Type}, {"dta_4_12", Int64.Type}, {"dta_12_plus", Int64.Type}, {"source_sha256", type text}}, "en-GB")
			in
				Typed
