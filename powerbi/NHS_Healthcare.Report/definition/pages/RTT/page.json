{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "RTT",
  "displayName": "RTT Waiting List Intelligence",
  "displayOption": "FitToPage",
  "height": 900,
  "width": 1600,
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F6F8FC'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ]
  },
  "pageBinding": {
    "name": "ProviderInvestigation",
    "type": "Drillthrough",
    "acceptsFilterContext": "Default",
    "parameters": [
      {
        "name": "Provider",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Provider"
              }
            },
            "Property": "provider_code"
          }
        }
      }
    ]
  }
}
